# このファイルをコピーして .env を作る。.env は .gitignore 済みでコミットされない。
#
#   cp .env.example .env

# New Relic の APM / Logs 用。API keys 画面の「Ingest - License」を貼る。
# 未設定でも Docker の API は起動する（New Relic に送らないだけ）。
NEW_RELIC_LICENSE_KEY=

# API を公開するアドレス。既定は自分の Mac からのみ。
# iPhone 実機から繋ぐときだけ 0.0.0.0 にする（同じ Wi-Fi の全員から見える点に注意）。
# API_BIND=0.0.0.0

# CORS は既定で無効。iOS アプリも curl もブラウザではないので不要。
# 有効にすると、利用者が開いた任意の Web ページから /chaos/* を叩けてしまう。
# ブラウザから試すときだけ、許可するオリジンを明示する。
# CORS_ORIGIN=http://localhost:3000
